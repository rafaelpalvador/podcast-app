<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/w_art" android:layout_width="96dp" android:layout_height="96dp"
        android:background="@drawable/art_bg" android:scaleType="centerCrop" android:src="@drawable/ic_w_logo" android:contentDescription="Capa" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:id="@+id/w_show" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#A6A3B0" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="Podcast" />
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#F3F4F6" android:textSize="15sp" android:textStyle="bold"
            android:maxLines="2" android:ellipsize="end" android:text="Nada tocando" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/w_back" android:layout_width="44dp" android:layout_height="44dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_w_back" android:contentDescription="Voltar" />
            <ImageButton android:id="@+id/w_play" android:layout_width="52dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                android:background="@drawable/btn_accent" android:src="@drawable/ic_w_play" android:contentDescription="Tocar ou pausar" />
            <ImageButton android:id="@+id/w_fwd" android:layout_width="44dp" android:layout_height="44dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_w_fwd" android:contentDescription="Avançar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
