<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:padding="10dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/w_art" android:layout_width="48dp" android:layout_height="48dp"
        android:background="@drawable/art_bg" android:scaleType="centerCrop" android:src="@drawable/ic_w_logo" android:contentDescription="Capa" />
    <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="10dp" android:layout_marginEnd="8dp" android:textColor="#F3F4F6" android:textSize="13sp" android:textStyle="bold"
        android:maxLines="2" android:ellipsize="end" android:text="Nada tocando" />
    <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp"
        android:background="@drawable/btn_accent" android:src="@drawable/ic_w_play" android:contentDescription="Tocar ou pausar" />
</LinearLayout>
